#!/usr/bin/env bash
set -Eeuo pipefail

TARGET="${GXFP51A0_KDE_LOCKSCREEN_QML:-/usr/share/plasma/shells/org.kde.plasma.desktop/contents/lockscreen/LockScreenUi.qml}"
V10_MARKER="GXFP51A0 cpp-lifecycle-auth fingerprint integration v10"
V11_MARKER="GXFP51A0 bounded-lockscreen-auth-retry fingerprint integration v11"
V12_MARKER="GXFP51A0 quiet-lockscreen-prompt fingerprint integration v12"
V9_MARKER="GXFP51A0 native-S3-continuity fingerprint integration v9"
V8_MARKER="GXFP51A0 upstream-suspend-safe fingerprint integration v8"
V7_MARKER="GXFP51A0 resume-delay-aware fingerprint integration v7"
V6_MARKER="GXFP51A0 parallel-start fingerprint integration v6"
V5_MARKER="GXFP51A0 window-ready fingerprint integration v5"
V4_MARKER="GXFP51A0 window-ready fingerprint integration v4"
V3_MARKER="GXFP51A0 window-ready fingerprint integration v3"
V2_MARKER="GXFP51A0 instant fingerprint integration v2"
V1_MARKER="GXFP51A0 instant fingerprint integration: arm PAM immediately"
START_BEGIN="// GXFP51A0 window-ready startup timer BEGIN"
START_END="// GXFP51A0 window-ready startup timer END"
RESUME_BEGIN="// GXFP51A0 resume rearm BEGIN"
RESUME_END="// GXFP51A0 resume rearm END"
HB_BEGIN="// GXFP51A0 upstream fingerprint heartbeat backport BEGIN"
HB_END="// GXFP51A0 upstream fingerprint heartbeat backport END"
mode="${1:---apply}"

[[ -f "$TARGET" ]] || exit 0
grep -Fq 'id: lockScreenRoot' "$TARGET" || exit 0
grep -Fq 'authenticator.startAuthenticating();' "$TARGET" || exit 0
grep -Fq 'onUiVisibleChanged:' "$TARGET" || exit 0

rewrite_v1_to_stock() {
  local tmp
  tmp="$(mktemp "${TARGET}.XXXXXX")"
  awk '
    $0 == "        Component.onCompleted: {" { hold=$0; next }
    hold != "" && $0 == "            launchAnimation.start();" { hold=hold "\n" $0; next }
    hold != "" && $0 ~ /GXFP51A0 instant fingerprint integration: arm PAM immediately/ { hold=hold "\n" $0; old=1; next }
    hold != "" && old && $0 ~ /while keeping the lock-screen UI visually idle/ { hold=hold "\n" $0; next }
    hold != "" && old && $0 == "            authenticator.startAuthenticating();" { hold=hold "\n" $0; next }
    hold != "" && old && $0 == "        }" {
      print "        Component.onCompleted: launchAnimation.start();"
      hold=""; old=0; next
    }
    hold != "" { print hold; hold=""; old=0 }
    { print }
    END { if (hold != "") print hold }
  ' "$TARGET" > "$tmp"
  chmod --reference="$TARGET" "$tmp"
  chown --reference="$TARGET" "$tmp"
  mv -f "$tmp" "$TARGET"
}

rewrite_v2_to_stock() {
  local tmp
  tmp="$(mktemp "${TARGET}.XXXXXX")"
  awk '
    $0 == "        Component.onCompleted: {" { hold=$0; next }
    hold != "" && $0 == "            launchAnimation.start();" { hold=hold "\n" $0; next }
    hold != "" && $0 ~ /GXFP51A0 instant fingerprint integration v2/ { hold=hold "\n" $0; mark=1; next }
    hold != "" && mark && $0 ~ /onUiVisibleChanged starts PAM/ { hold=hold "\n" $0; next }
    hold != "" && mark && $0 == "            uiVisible = true;" { hold=hold "\n" $0; next }
    hold != "" && mark && $0 == "        }" {
      print "        Component.onCompleted: launchAnimation.start();"
      hold=""; mark=0; next
    }
    hold != "" { print hold; hold=""; mark=0 }
    { print }
    END { if (hold != "") print hold }
  ' "$TARGET" > "$tmp"
  chmod --reference="$TARGET" "$tmp"
  chown --reference="$TARGET" "$tmp"
  mv -f "$tmp" "$TARGET"
}

rewrite_modern_to_stock() {
  local tmp
  tmp="$(mktemp "${TARGET}.XXXXXX")"
  awk '
    /\/\/ GXFP51A0 window-ready startup timer BEGIN/ { startup=1; next }
    startup && /\/\/ GXFP51A0 window-ready startup timer END/ { startup=0; next }
    /\/\/ GXFP51A0 resume rearm BEGIN/ { resume=1; next }
    resume && /\/\/ GXFP51A0 resume rearm END/ { resume=0; next }
    /\/\/ GXFP51A0 upstream fingerprint heartbeat backport BEGIN/ { hb=1; next }
    hb && /\/\/ GXFP51A0 upstream fingerprint heartbeat backport END/ { hb=0; next }
    startup || resume || hb { next }

    $0 == "        Component.onCompleted: {" { hold=$0; next }
    hold != "" && $0 == "            launchAnimation.start();" { hold=hold "\n" $0; next }
    hold != "" && $0 ~ /GXFP51A0 (window-ready fingerprint integration v[345]|parallel-start fingerprint integration v6|resume-delay-aware fingerprint integration v7|upstream-suspend-safe fingerprint integration v8|native-S3-continuity fingerprint integration v9|cpp-lifecycle-auth fingerprint integration v10|bounded-lockscreen-auth-retry fingerprint integration v11)/ { hold=hold "\n" $0; mark=1; next }
    hold != "" && mark && $0 == "            authenticator.startAuthenticating();" { hold=hold "\n" $0; next }
    hold != "" && mark && $0 == "            gxfp51a0StartupAuthTimer.start();" { hold=hold "\n" $0; next }
    hold != "" && mark && $0 == "        }" {
      print "        Component.onCompleted: launchAnimation.start();"
      hold=""; mark=0; next
    }
    hold != "" { print hold; hold=""; mark=0 }
    { print }
    END { if (hold != "") print hold }
  ' "$TARGET" > "$tmp"
  chmod --reference="$TARGET" "$tmp"
  chown --reference="$TARGET" "$tmp"
  mv -f "$tmp" "$TARGET"
}

rewrite_v3_to_v4() {
  local tmp
  tmp="$(mktemp "${TARGET}.XXXXXX")"
  awk '
    /\/\/ GXFP51A0 upstream fingerprint heartbeat backport BEGIN/ { hb=1; next }
    hb && /\/\/ GXFP51A0 upstream fingerprint heartbeat backport END/ { hb=0; next }
    hb { next }
    {
      gsub(/GXFP51A0 window-ready fingerprint integration v3/,
           "GXFP51A0 window-ready fingerprint integration v4")
      print
    }
  ' "$TARGET" > "$tmp"
  chmod --reference="$TARGET" "$tmp"
  chown --reference="$TARGET" "$tmp"
  mv -f "$tmp" "$TARGET"
}

rewrite_v4_to_v5() {
  local tmp
  tmp="$(mktemp "${TARGET}.XXXXXX")"
  awk '
    $0 == "        onBlockUIChanged: {" && !inserted {
      print "        // GXFP51A0 resume rearm BEGIN"
      print "        property bool gxfp51a0ResumeRearmPending: false"
      print "        Connections {"
      print "            target: sessionManagement"
      print "            function onResumingFromSuspend() {"
      print "                lockScreenRoot.gxfp51a0ResumeRearmPending = true;"
      print "                // If PAM is already idle this starts immediately. If the"
      print "                // pre-suspend password conversation is still unwinding,"
      print "                // startAuthenticating() is a no-op and onStateChanged below"
      print "                // retries exactly once when the old backend reaches Idle."
      print "                authenticator.startAuthenticating();"
      print "            }"
      print "        }"
      print "        Connections {"
      print "            target: authenticator"
      print "            function onStateChanged() {"
      print "                if (!lockScreenRoot.gxfp51a0ResumeRearmPending) {"
      print "                    return;"
      print "                }"
      print "                lockScreenRoot.gxfp51a0ResumeRearmPending = false;"
      print "                authenticator.startAuthenticating();"
      print "            }"
      print "        }"
      print "        // GXFP51A0 resume rearm END"
      inserted=1
    }
    {
      gsub(/GXFP51A0 window-ready fingerprint integration v4/,
           "GXFP51A0 window-ready fingerprint integration v5")
      print
    }
    END {
      if (!inserted)
        exit 42
    }
  ' "$TARGET" > "$tmp" || {
    rm -f "$tmp"
    echo "GXFP51A0: unsupported KDE LockScreenUi.qml; no v5 resume rearm applied" >&2
    return 42
  }
  chmod --reference="$TARGET" "$tmp"
  chown --reference="$TARGET" "$tmp"
  mv -f "$tmp" "$TARGET"
}

rewrite_v5_to_v6() {
  local tmp
  tmp="$(mktemp "${TARGET}.XXXXXX")"
  awk '
    $0 ~ /GXFP51A0 window-ready fingerprint integration v5/ && !done {
      sub(/GXFP51A0 window-ready fingerprint integration v5/,
          "GXFP51A0 parallel-start fingerprint integration v6")
      print
      print "            authenticator.startAuthenticating();"
      done=1
      next
    }
    { print }
    END {
      if (!done)
        exit 42
    }
  ' "$TARGET" > "$tmp" || {
    rm -f "$tmp"
    echo "GXFP51A0: unsupported KDE LockScreenUi.qml; no v6 parallel auth applied" >&2
    return 42
  }
  chmod --reference="$TARGET" "$tmp"
  chown --reference="$TARGET" "$tmp"
  mv -f "$tmp" "$TARGET"
}

rewrite_v6_to_v7() {
  local tmp
  tmp="$(mktemp "${TARGET}.XXXXXX")"
  awk '
    /\/\/ GXFP51A0 resume rearm BEGIN/ && !done {
      print "        // GXFP51A0 resume rearm BEGIN"
      print "        property bool gxfp51a0ResumeRearmPending: false"
      print "        property bool gxfp51a0ResumeDelayActive: false"
      print "        Timer {"
      print "            id: gxfp51a0ResumeRearmTimer"
      print "            interval: 100"
      print "            repeat: false"
      print "            property int polls: 0"
      print "            onTriggered: {"
      print "                if (!lockScreenRoot.gxfp51a0ResumeRearmPending) {"
      print "                    return;"
      print "                }"
      print "                if (lockScreenRoot.gxfp51a0ResumeDelayActive) {"
      print "                    lockScreenRoot.gxfp51a0ResumeDelayActive = false;"
      print "                }"
      print "                if (authenticator.state === 0) {"
      print "                    lockScreenRoot.gxfp51a0ResumeRearmPending = false;"
      print "                    authenticator.startAuthenticating();"
      print "                    return;"
      print "                }"
      print "                polls++;"
      print "                if (polls < 50) {"
      print "                    interval = 100;"
      print "                    restart();"
      print "                }"
      print "            }"
      print "        }"
      print "        Connections {"
      print "            target: sessionManagement"
      print "            function onResumingFromSuspend() {"
      print "                lockScreenRoot.gxfp51a0ResumeRearmPending = true;"
      print "                lockScreenRoot.gxfp51a0ResumeDelayActive = false;"
      print "                gxfp51a0ResumeRearmTimer.polls = 0;"
      print "                gxfp51a0ResumeRearmTimer.interval = 100;"
      print "                gxfp51a0ResumeRearmTimer.restart();"
      print "            }"
      print "        }"
      print "        Connections {"
      print "            target: authenticator"
      print "            function onStateChanged() {"
      print "                if (lockScreenRoot.gxfp51a0ResumeRearmPending"
      print "                    && !lockScreenRoot.gxfp51a0ResumeDelayActive) {"
      print "                    gxfp51a0ResumeRearmTimer.interval = 50;"
      print "                    gxfp51a0ResumeRearmTimer.restart();"
      print "                }"
      print "            }"
      print "            function onLoginFailedDelayStarted(what, source, uSecDelay) {"
      print "                if (!lockScreenRoot.gxfp51a0ResumeRearmPending || what !== 0) {"
      print "                    return;"
      print "                }"
      print "                lockScreenRoot.gxfp51a0ResumeDelayActive = true;"
      print "                gxfp51a0ResumeRearmTimer.interval = Math.max(100, Math.ceil(uSecDelay / 1000) + 50);"
      print "                gxfp51a0ResumeRearmTimer.restart();"
      print "            }"
      print "        }"
      print "        // GXFP51A0 resume rearm END"
      skip=1; done=1; next
    }
    skip && /\/\/ GXFP51A0 resume rearm END/ { skip=0; next }
    skip { next }
    {
      gsub(/GXFP51A0 parallel-start fingerprint integration v6/,
           "GXFP51A0 resume-delay-aware fingerprint integration v7")
      print
    }
    END { if (!done) exit 42 }
  ' "$TARGET" > "$tmp" || {
    rm -f "$tmp"
    echo "GXFP51A0: unsupported KDE LockScreenUi.qml; no v7 resume rearm applied" >&2
    return 42
  }
  chmod --reference="$TARGET" "$tmp"
  chown --reference="$TARGET" "$tmp"
  mv -f "$tmp" "$TARGET"
}

rewrite_v7_to_v8() {
  local tmp
  tmp="$(mktemp "${TARGET}.XXXXXX")"
  awk '
    /\/\/ GXFP51A0 resume rearm BEGIN/ { resume=1; next }
    resume && /\/\/ GXFP51A0 resume rearm END/ { resume=0; next }
    resume { next }
    {
      gsub(/GXFP51A0 resume-delay-aware fingerprint integration v7/,
           "GXFP51A0 upstream-suspend-safe fingerprint integration v8")
      print
    }
  ' "$TARGET" > "$tmp"
  chmod --reference="$TARGET" "$tmp"
  chown --reference="$TARGET" "$tmp"
  mv -f "$tmp" "$TARGET"
}

apply_v7() {
  local tmp

  grep -Fq "$V7_MARKER" "$TARGET" && return 0
  if grep -Fq "$V6_MARKER" "$TARGET"; then
    rewrite_v6_to_v7
    return 0
  fi
  if grep -Fq "$V5_MARKER" "$TARGET"; then
    rewrite_v5_to_v6
    rewrite_v6_to_v7
    return 0
  fi
  if grep -Fq "$V4_MARKER" "$TARGET"; then
    rewrite_v4_to_v5
    rewrite_v5_to_v6
    rewrite_v6_to_v7
    return 0
  fi
  if grep -Fq "$V3_MARKER" "$TARGET"; then
    rewrite_v3_to_v4
    rewrite_v4_to_v5
    rewrite_v5_to_v6
    rewrite_v6_to_v7
    return 0
  fi
  grep -Fq "$V1_MARKER" "$TARGET" && rewrite_v1_to_stock
  grep -Fq "$V2_MARKER" "$TARGET" && rewrite_v2_to_stock

  tmp="$(mktemp "${TARGET}.XXXXXX")"
  trap 'rm -f "$tmp"' RETURN

  awk '
    $0 == "        onBlockUIChanged: {" && !inserted {
      print "        // GXFP51A0 window-ready startup timer BEGIN"
      print "        Timer {"
      print "            id: gxfp51a0StartupAuthTimer"
      print "            interval: 25"
      print "            repeat: true"
      print "            triggeredOnStart: true"
      print "            property int attempts: 0"
      print "            onTriggered: {"
      print "                attempts++;"
      print "                if (lockScreenRoot.Window.window) {"
      print "                    stop();"
      print "                    lockScreenRoot.uiVisible = true;"
      print "                } else if (attempts >= 80) {"
      print "                    stop();"
      print "                    console.warn(\"GXFP51A0: lockscreen Window not ready for fingerprint startup\");"
      print "                }"
      print "            }"
      print "            onRunningChanged: {"
      print "                if (running) {"
      print "                    attempts = 0;"
      print "                }"
      print "            }"
      print "        }"
      print "        // GXFP51A0 window-ready startup timer END"
      print "        // GXFP51A0 resume rearm BEGIN"
      print "        property bool gxfp51a0ResumeRearmPending: false"
      print "        Connections {"
      print "            target: sessionManagement"
      print "            function onResumingFromSuspend() {"
      print "                lockScreenRoot.gxfp51a0ResumeRearmPending = true;"
      print "                authenticator.startAuthenticating();"
      print "            }"
      print "        }"
      print "        Connections {"
      print "            target: authenticator"
      print "            function onStateChanged() {"
      print "                if (!lockScreenRoot.gxfp51a0ResumeRearmPending) {"
      print "                    return;"
      print "                }"
      print "                lockScreenRoot.gxfp51a0ResumeRearmPending = false;"
      print "                authenticator.startAuthenticating();"
      print "            }"
      print "        }"
      print "        // GXFP51A0 resume rearm END"
      inserted=1
    }

    $0 == "        Component.onCompleted: launchAnimation.start();" {
      print "        Component.onCompleted: {"
      print "            launchAnimation.start();"
      print "            // GXFP51A0 parallel-start fingerprint integration v6"
      print "            authenticator.startAuthenticating();"
      print "            gxfp51a0StartupAuthTimer.start();"
      print "        }"
      completed=1
      next
    }

    { print }
    END {
      if (!inserted || !completed)
        exit 42
    }
  ' "$TARGET" > "$tmp" || {
    echo "GXFP51A0: unsupported KDE LockScreenUi.qml; no v6 lockscreen patch applied" >&2
    return 42
  }

  chmod --reference="$TARGET" "$tmp"
  chown --reference="$TARGET" "$tmp"
  mv -f "$tmp" "$TARGET"
  trap - RETURN
  rewrite_v6_to_v7
}

apply_v8() {
  grep -Fq "$V8_MARKER" "$TARGET" && return 0

  if grep -Fq "$V7_MARKER" "$TARGET"; then
    rewrite_v7_to_v8
    return 0
  fi

  # Reuse the fully tested historical migration chain, then remove the resume
  # workaround now that KScreenLocker itself carries upstream MR !340.
  apply_v7
  rewrite_v7_to_v8
}

rewrite_v8_to_v9() {
  local tmp
  tmp="$(mktemp "${TARGET}.XXXXXX")"
  awk '
    /\/\/ GXFP51A0 window-ready startup timer END/ && !kick {
      print
      print "        // GXFP51A0 resume rearm BEGIN"
      print "        Connections {"
      print "            target: sessionManagement"
      print "            function onResumingFromSuspend() {"
      print "                // If authentication was already running, this is a no-op."
      print "                // If the greeter reached S3 before startup auth began, this"
      print "                // starts password + fingerprint immediately on resume."
      print "                gxfp51a0StartupAuthTimer.restart();"
      print "                authenticator.startAuthenticating();"
      print "            }"
      print "        }"
      print "        // GXFP51A0 resume rearm END"
      kick=1
      next
    }
    /GXFP51A0 upstream-suspend-safe fingerprint integration v8/ && !done {
      sub(/GXFP51A0 upstream-suspend-safe fingerprint integration v8/,
          "GXFP51A0 native-S3-continuity fingerprint integration v9")
      print
      getline
      if ($0 != "            authenticator.startAuthenticating();") {
        print
      }
      done=1
      next
    }
    { print }
    END { if (!kick || !done) exit 42 }
  ' "$TARGET" > "$tmp" || {
    rm -f "$tmp"
    echo "GXFP51A0: unsupported KDE LockScreenUi.qml; no v9 migration applied" >&2
    return 42
  }
  chmod --reference="$TARGET" "$tmp"
  chown --reference="$TARGET" "$tmp"
  mv -f "$tmp" "$TARGET"
}

rewrite_v9_to_v10() {
  local tmp
  tmp="$(mktemp "${TARGET}.XXXXXX")"
  awk '
    /\/\/ GXFP51A0 resume rearm BEGIN/ { resume=1; next }
    resume && /\/\/ GXFP51A0 resume rearm END/ { resume=0; next }
    resume { next }
    {
      gsub(/GXFP51A0 native-S3-continuity fingerprint integration v9/,
           "GXFP51A0 cpp-lifecycle-auth fingerprint integration v10")
      print
    }
  ' "$TARGET" > "$tmp"
  chmod --reference="$TARGET" "$tmp"
  chown --reference="$TARGET" "$tmp"
  mv -f "$tmp" "$TARGET"
}

apply_v9() {
  grep -Fq "$V9_MARKER" "$TARGET" && return 0
  if ! grep -Fq "$V8_MARKER" "$TARGET"; then
    apply_v8
  fi
  rewrite_v8_to_v9
}

apply_v10() {
  grep -Fq "$V10_MARKER" "$TARGET" && return 0
  if ! grep -Fq "$V9_MARKER" "$TARGET"; then
    apply_v9
  fi
  rewrite_v9_to_v10
}

rewrite_v10_to_v11() {
  local tmp
  tmp="$(mktemp "$TARGET.XXXXXX")"
  awk '
    /\/\/ GXFP51A0 window-ready startup timer BEGIN/ {
      print
      print "        Timer {"
      print "            id: gxfp51a0StartupAuthTimer"
      print "            interval: 500"
      print "            repeat: true"
      print "            triggeredOnStart: true"
      print "            property int attempts: 0"
      print "            onTriggered: {"
      print "                attempts++;"
      print "                if (attempts === 1) {"
      print "                    console.info(\"GXFP51A0 v11: starting bounded startup/auth retry\");"
      print "                }"
      print "                if (lockScreenRoot.Window.window && !authenticator.unlocked) {"
      print "                    // KDE 6.8 can drop the first call before its PAM worker is ready."
      print "                    // Recover uiVisible after ActiveScreenMonitor deactivates"
      print "                    // it during construction, otherwise KDE heartbeat never runs."
      print "                    lockScreenRoot.uiVisible = true;"
      print "                    authenticator.startAuthenticating();"
      print "                }"
      print "                if (authenticator.unlocked || attempts >= 16) {"
      print "                    console.info(\"GXFP51A0 v11: bounded retry stopped attempts=\" + attempts"
      print "                                 + \" uiVisible=\" + lockScreenRoot.uiVisible);"
      print "                    stop();"
      print "                }"
      print "            }"
      print "            onRunningChanged: {"
      print "                if (running) {"
      print "                    attempts = 0;"
      print "                }"
      print "            }"
      print "        }"
      inside=1
      begin++
      next
    }
    inside && /\/\/ GXFP51A0 window-ready startup timer END/ {
      print
      inside=0
      end++
      next
    }
    inside { next }
    {
      gsub(/GXFP51A0 cpp-lifecycle-auth fingerprint integration v10/,
           "GXFP51A0 bounded-lockscreen-auth-retry fingerprint integration v11")
      print
      if (/GXFP51A0 bounded-lockscreen-auth-retry fingerprint integration v11/)
        marker++
    }
    END { if (begin != 1 || end != 1 || marker != 1) exit 42 }
  ' "$TARGET" > "$tmp" || {
    rm -f "$tmp"
    echo "GXFP51A0: unsupported QML; no v11 activation retry applied" >&2
    return 42
  }
  chmod --reference="$TARGET" "$tmp"
  chown --reference="$TARGET" "$tmp"
  mv -f "$tmp" "$TARGET"
}

apply_v11() {
  grep -Fq "$V11_MARKER" "$TARGET" && return 0
  if ! grep -Fq "$V10_MARKER" "$TARGET"; then
    apply_v10
  fi
  rewrite_v10_to_v11
}

rewrite_v11_to_v12() {
  local tmp
  tmp="$(mktemp "$TARGET.XXXXXX")"
  awk '
    $0 == "        property bool uiVisible: false" {
      print
      print "        // GXFP51A0 v12 silent-visual state BEGIN"
      print "        property bool gxfp51a0SilentVisual: true"
      print "        readonly property bool gxfp51a0ShowPrompt: uiVisible && !gxfp51a0SilentVisual"
      print "        // GXFP51A0 v12 silent-visual state END"
      prop++; next
    }
    $0 == "        onPressed: uiVisible = true;" {
      print "        onPressed: { gxfp51a0SilentVisual = false; uiVisible = true; } // GXFP51A0 v12"
      press++; next
    }
    $0 == "            uiVisible = seenPositionChange;" {
      print
      print "            // GXFP51A0 v12 mouse interaction BEGIN"
      print "            if (seenPositionChange) gxfp51a0SilentVisual = false;"
      print "            // GXFP51A0 v12 mouse interaction END"
      motion++; next
    }
    $0 == "        onUiVisibleChanged: {" {
      print
      print "            // GXFP51A0 v12: reset visual state after fade-out/escape."
      print "            if (!uiVisible) gxfp51a0SilentVisual = true; // GXFP51A0 v12"
      vis++; next
    }
    $0 == "        onBlockUIChanged: {" { inblock=1; print; next }
    inblock && $0 == "            if (blockUI) {" {
      print
      print "                gxfp51a0SilentVisual = false; // GXFP51A0 v12"
      block++; inblock=0; next
    }
    $0 == "        Keys.onPressed: event => {" { inkeys=1; print; next }
    inkeys && $0 == "            uiVisible = true;" {
      print "            gxfp51a0SilentVisual = false; // GXFP51A0 v12"
      print
      keys++; inkeys=0; next
    }
    $0 == "        cursorShape: uiVisible ? Qt.ArrowCursor : Qt.BlankCursor" {
      print "        cursorShape: gxfp51a0ShowPrompt ? Qt.ArrowCursor : Qt.BlankCursor"
      cursor++; next
    }
    $0 == "            state: lockScreenRoot.uiVisible ? \"on\" : \"off\"" {
      print "            state: lockScreenRoot.gxfp51a0ShowPrompt ? \"on\" : \"off\""
      wallpaper++; next
    }
    $0 == "            opacity: lockScreenRoot.uiVisible ? 0 : 1" {
      print "            opacity: lockScreenRoot.gxfp51a0ShowPrompt ? 0 : 1"
      shadow++; next
    }
    $0 == "                lockScreenUiVisible: lockScreenRoot.uiVisible" {
      print "                lockScreenUiVisible: lockScreenRoot.gxfp51a0ShowPrompt"
      mainblock++; next
    }
    {
      gsub(/GXFP51A0 bounded-lockscreen-auth-retry fingerprint integration v11/,
           "GXFP51A0 quiet-lockscreen-prompt fingerprint integration v12")
      print
      if (/GXFP51A0 quiet-lockscreen-prompt fingerprint integration v12/)
        marker++
    }
    END {
      if (prop!=1 || press!=1 || motion!=1 || vis!=1 || block!=1 ||
          keys!=1 || cursor!=1 || wallpaper!=1 || shadow!=1 ||
          mainblock!=1 || marker!=1) exit 42
    }
  ' "$TARGET" > "$tmp" || {
    rm -f "$tmp"
    echo "GXFP51A0: unsupported QML; no v12 visual separation applied" >&2
    return 42
  }
  chmod --reference="$TARGET" "$tmp"
  chown --reference="$TARGET" "$tmp"
  mv -f "$tmp" "$TARGET"
}

rewrite_v12_to_v11() {
  local tmp
  tmp="$(mktemp "$TARGET.XXXXXX")"
  awk '
    /\/\/ GXFP51A0 v12 silent-visual state BEGIN/ { silent=1; next }
    silent && /\/\/ GXFP51A0 v12 silent-visual state END/ { silent=0; next }
    silent { next }
    /\/\/ GXFP51A0 v12 mouse interaction BEGIN/ { mouse=1; next }
    mouse && /\/\/ GXFP51A0 v12 mouse interaction END/ { mouse=0; next }
    mouse { next }
    $0 == "        onPressed: { gxfp51a0SilentVisual = false; uiVisible = true; } // GXFP51A0 v12" {
      print "        onPressed: uiVisible = true;"
      next
    }
    /GXFP51A0 v12: reset visual state after fade-out\/escape/ { next }
    /gxfp51a0SilentVisual = true; \/\/ GXFP51A0 v12/ { next }
    /gxfp51a0SilentVisual = false; \/\/ GXFP51A0 v12/ { next }
    $0 == "        cursorShape: gxfp51a0ShowPrompt ? Qt.ArrowCursor : Qt.BlankCursor" {
      print "        cursorShape: uiVisible ? Qt.ArrowCursor : Qt.BlankCursor"
      next
    }
    $0 == "            state: lockScreenRoot.gxfp51a0ShowPrompt ? \"on\" : \"off\"" {
      print "            state: lockScreenRoot.uiVisible ? \"on\" : \"off\""
      next
    }
    $0 == "            opacity: lockScreenRoot.gxfp51a0ShowPrompt ? 0 : 1" {
      print "            opacity: lockScreenRoot.uiVisible ? 0 : 1"
      next
    }
    $0 == "                lockScreenUiVisible: lockScreenRoot.gxfp51a0ShowPrompt" {
      print "                lockScreenUiVisible: lockScreenRoot.uiVisible"
      next
    }
    {
      gsub(/GXFP51A0 quiet-lockscreen-prompt fingerprint integration v12/,
           "GXFP51A0 bounded-lockscreen-auth-retry fingerprint integration v11")
      print
    }
  ' "$TARGET" > "$tmp" || { rm -f "$tmp"; return 42; }
  chmod --reference="$TARGET" "$tmp"
  chown --reference="$TARGET" "$tmp"
  mv -f "$tmp" "$TARGET"
}

apply_v12() {
  grep -Fq "$V12_MARKER" "$TARGET" && return 0
  if ! grep -Fq "$V11_MARKER" "$TARGET"; then
    apply_v11
  fi
  rewrite_v11_to_v12
}

case "$mode" in
  --apply)
    # APPLY_QUARANTINED_AFTER_SLEEP_LOCKOUT (2026-11-19):
    # No normal installer or pacman hook may re-enable v12 after a real
    # deep-S3 lockout with unavailable fingerprint AND password input.
    echo "GXFP51A0: KDE v12 QML integration quarantined; --apply is a safe no-op." >&2
    echo "GXFP51A0: --remove restores stock; --apply-experimental requires supervised QA." >&2
    ;;
  --apply-experimental)
    apply_v12
    ;;
  --remove)
    grep -Fq "$V1_MARKER" "$TARGET" && rewrite_v1_to_stock
    grep -Fq "$V2_MARKER" "$TARGET" && rewrite_v2_to_stock
    grep -Fq "$V12_MARKER" "$TARGET" && rewrite_v12_to_v11
    if grep -Fq "$V3_MARKER" "$TARGET" || grep -Fq "$V4_MARKER" "$TARGET" || grep -Fq "$V5_MARKER" "$TARGET" || grep -Fq "$V6_MARKER" "$TARGET" || grep -Fq "$V7_MARKER" "$TARGET" || grep -Fq "$V8_MARKER" "$TARGET" || grep -Fq "$V9_MARKER" "$TARGET" || grep -Fq "$V10_MARKER" "$TARGET" || grep -Fq "$V11_MARKER" "$TARGET"; then
      rewrite_modern_to_stock
    fi
    ;;
  --check)
    grep -Fq "$V12_MARKER" "$TARGET"
    grep -Fq 'property bool gxfp51a0SilentVisual: true' "$TARGET"
    grep -Fq 'readonly property bool gxfp51a0ShowPrompt: uiVisible && !gxfp51a0SilentVisual' "$TARGET"
    grep -Fq 'state: lockScreenRoot.gxfp51a0ShowPrompt ? "on" : "off"' "$TARGET"
    grep -Fq 'lockScreenUiVisible: lockScreenRoot.gxfp51a0ShowPrompt' "$TARGET"
    grep -Fq 'id: gxfp51a0StartupAuthTimer' "$TARGET"
    grep -Fq 'interval: 500' "$TARGET"
    grep -Fq 'authenticator.unlocked || attempts >= 16' "$TARGET"
    grep -Fq 'authenticator.startAuthenticating();' "$TARGET"
    grep -Fq 'if (lockScreenRoot.Window.window && !authenticator.unlocked)' "$TARGET"
    grep -Fq 'gxfp51a0StartupAuthTimer.start();' "$TARGET"
    grep -A4 -F 'GXFP51A0 quiet-lockscreen-prompt fingerprint integration v12' "$TARGET" | grep -Fq 'gxfp51a0StartupAuthTimer.start();'
    ! grep -A4 -F 'GXFP51A0 quiet-lockscreen-prompt fingerprint integration v12' "$TARGET" | grep -Fq 'authenticator.startAuthenticating();'
    grep -Fq 'Window.window.requestActivate();' "$TARGET"
    ! grep -Fq 'GXFP51A0 resume rearm BEGIN' "$TARGET"
    ! grep -Fq 'function onResumingFromSuspend()' "$TARGET"
    ! grep -Fq 'gxfp51a0ResumeRearmPending' "$TARGET"
    ! grep -Fq 'gxfp51a0ResumeRearmTimer' "$TARGET"
    ! grep -Fq 'onLoginFailedDelayStarted' "$TARGET"
    ! grep -Fq 'GXFP51A0 upstream fingerprint heartbeat backport BEGIN' "$TARGET"
    ;;
  *)
    echo "usage: $0 [--apply (safe no-op)|--remove|--check|--apply-experimental (unsafe)]" >&2
    exit 2
    ;;
esac
