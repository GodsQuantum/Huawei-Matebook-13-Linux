+void Display::commitSuccessfulAuth(Auth *winner, QLocalSocket *socket)
+{
+    if (m_loginCommitted) {
+        if (winner != m_committedAuth && winner->isActive()) {
+            winner->stop();
+        }
+        return;
+    }
+    m_loginCommitted = true;
+    m_committedAuth = winner;
+    m_passPhrase.clear();
+    qDebug() << "PLM authenticated by" << (winner == m_fingerprintAuth ? "fingerprint" : "password");
+
+    // The losing helper must be terminated BEFORE a second session can start.
+    if (winner != m_auth && m_auth->isActive()) {
+        m_auth->stop();
+        m_socket = nullptr;
+    }
+    if (winner != m_fingerprintAuth && m_fingerprintAuth->isActive()) {
+        m_fingerprintAuth->stop();
+        m_fingerprintSocket = nullptr;
+    }
+
+    if (!m_reuseSessionId.isNull()) {
+        seat()->activateSession(m_reuseSessionId);
+    }
+    if (socket) {
+        emit loginSucceeded(socket);
+    }
+}
+
+void Display::resetAuthContextIfIdle()
+{
+    if (m_loginCommitted || m_auth->isActive() || m_fingerprintAuth->isActive()) {
+        return;
+    }
+    // Keep the allocated VT and login session context across bounded
+    // fingerprint retries. Releasing it here would allocate a new VT every
+    // ~30 seconds while waiting at the login screen. prepareAuthContext()
+    // rebuilds it only if the user/session actually changes.
+    m_passPhrase.clear();
+}
