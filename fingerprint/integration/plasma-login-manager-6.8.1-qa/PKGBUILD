# QA ONLY. Do not install without supervised physical testing.
# Native Plasma Login Manager 6.8.1 with independent, fail-closed fingerprint PAM.
pkgname=plasma-login-manager-gxfp51a0-qa
pkgver=6.8.1
pkgrel=1
pkgdesc='QA-only Plasma Login Manager native concurrent password and fingerprint'
arch=('x86_64')
url='https://invent.kde.org/plasma/plasma-login-manager'
license=('GPL-2.0-or-later')
provides=('plasma-login-manager=6.8.1')
conflicts=('plasma-login-manager')
depends=(fprintd glibc kauth kcmutils kconfig kcoreaddons kdbusaddons ki18n kio kirigami
         kpackage kservice kwindowsystem layer-shell-qt libkscreen libplasma
         libstdc++ libxau pam plasma-workspace qt6-5compat qt6-base
         qt6-declarative sh systemd-libs)
makedepends=(extra-cmake-modules qt6-tools)
source=("https://download.kde.org/stable/plasma/6.8.1/plasma-login-manager-6.8.1.tar.xz"
        "0001-plasma-login-6.8.1-native-dual-fingerprint-password.patch")
sha256sums=('c9228146d26878a2d236ae6fc3460e0722cf4d62bf86ddf7ae1d5011c8d7d7d7'
            '2c4abc8c8b165250fcdbffe0839c3c7bac10bbb14cb60fe4b85fd2778ce78140')

prepare() {
  cd "plasma-login-manager-$pkgver"
  patch -Np1 --fuzz=0 -i "../0001-plasma-login-6.8.1-native-dual-fingerprint-password.patch"
}

build() {
  cmake -S "plasma-login-manager-$pkgver" -B build     -DCMAKE_INSTALL_PREFIX=/usr     -DCMAKE_INSTALL_LIBEXECDIR=lib     -DDBUS_CONFIG_FILENAME=plasma_org.freedesktop.DisplayManager.conf     -DCMAKE_BUILD_TYPE=Release
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
