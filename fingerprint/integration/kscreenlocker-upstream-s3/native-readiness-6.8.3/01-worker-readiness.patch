+// SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+#pragma once
+
+#include "pamauthenticators.h"
+
+#include <QQuickView>
+#include <QScreen>
+#include <algorithm>
+
+// A success is delivered to the theme's Connections. Only a completed view can consume it.
+class LockViews
+{
+public:
+    explicit LockViews(PamAuthenticators &auth)
+        : m_auth(auth)
+    {
+        m_auth.setGraceLocked(true);
+    }
+
+    const QList<QQuickView *> &items() const
+    {
+        return m_views;
+    }
+
+    void add(QQuickView *view)
+    {
+        m_views.append(view);
+        update();
+    }
+
+    void remove(QQuickView *view)
+    {
+        m_views.removeOne(view);
+        update();
+    }
+
+    void setLocked(bool locked)
+    {
+        m_locked = locked;
+        update();
+    }
+
+    void update()
+    {
+        const bool allowed = m_locked && std::ranges::any_of(m_views, [](const QQuickView *view) {
+            return view->screen() && !view->screen()->geometry().isEmpty();
+        });
+        if (m_allowed == allowed) {
+            return;
+        }
+        m_allowed = allowed;
+        m_auth.setGraceLocked(!allowed);
+        if (allowed) {
+            m_auth.startAuthenticating();
+        }
+    }
+
+private:
+    QList<QQuickView *> m_views;
+    PamAuthenticators &m_auth;
+    bool m_locked = false;
+    bool m_allowed = false;
+};
