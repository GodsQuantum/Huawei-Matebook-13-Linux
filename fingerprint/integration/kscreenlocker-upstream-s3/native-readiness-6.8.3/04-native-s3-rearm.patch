+void PamAuthenticators::resumeFingerprintAfterSleep()
+{
+    // A greeter can remain alive while the kernel is suspended; stale
+    // fingerprint PAM workers must not block the next placement.
+    if (!d->locked || d->graceLocked || m_authenticator != Authenticator::Regular || !d->m_fingerprintAuthenticator) {
+        return;
+    }
+    auto *reader = d->m_fingerprintAuthenticator.get();
+    reader->cancel();
+    reader->resetUnavailableAfterSleep();
+    reader->tryUnlock();
