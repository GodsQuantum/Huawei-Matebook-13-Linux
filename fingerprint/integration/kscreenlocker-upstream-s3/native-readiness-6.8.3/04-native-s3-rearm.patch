+void PamAuthenticator::resetUnavailableAfterSleep()
+{
+    // A true OS sleep/resume establishes a new device epoch. Do not weaken
+    // the matcher or clear throttling for ordinary password/fingerprint misses.
+    if (!m_unavailable) {
+        return;
+    }
+    m_unavailable = false;
+    m_failedCount = 0;
+    Q_EMIT availableChanged();
+}
