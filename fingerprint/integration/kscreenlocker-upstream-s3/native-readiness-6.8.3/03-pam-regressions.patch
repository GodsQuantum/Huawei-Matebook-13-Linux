+// SPDX-License-Identifier: GPL-2.0-or-later
+// Test-only module. It reports entry into a conversation and never authenticates anyone.
+#include <security/pam_ext.h>
+#include <security/pam_modules.h>
+#include <string.h>
+#include <time.h>
+
+#define EXPORTED __attribute__((visibility("default")))
+
+EXPORTED int pam_sm_authenticate(pam_handle_t *pamh, int flags, int argc, const char **argv)
+{
+    (void)flags;
+    if (pam_info(pamh, "readiness-test-attempt") != PAM_SUCCESS) {
+        return PAM_SYSTEM_ERR;
+    }
+    if (argc == 0) {
+        return PAM_IGNORE;
+    }
+    if (strcmp(argv[0], "timeout") == 0) {
+        const struct timespec verification = {0, 300 * 1000 * 1000};
+        nanosleep(&verification, NULL);
+    }
+    return PAM_AUTHINFO_UNAVAIL;
+}
+
+EXPORTED int pam_sm_setcred(pam_handle_t *pamh, int flags, int argc, const char **argv)
+{
+    (void)pamh;
+    (void)flags;
+    (void)argc;
+    (void)argv;
+    return PAM_IGNORE;
+}
